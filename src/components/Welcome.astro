<style>

	.contenedorproyectos{
		display: flex;
		flex-direction: column;
		gap: 20px;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		display: grid;
		grid-auto-rows: minmax(50px, auto);
	}
	.contenedorproyectos h2{
		font-size: 2rem;
		width: 100%;
		margin-bottom: 1rem;
		font-family: "Arial", sans-serif;
		display: grid;
		grid-row-start: 1;
		grid-row-end: span -1; 
		grid-column-start: 1;
		grid-column: 1 / -1;
	}

	.proyecto{
		display: flex;
		flex-direction: column;
		align-items: start;
		justify-content: start;
		border-radius: 8px;
		background-color: #fffffc;
				box-shadow: 0 4px 6px rgba(0.1, 0.1, 0.1, 0.1);
				border: 2px solid rgb(255, 254, 234);
				
	}

	.proyecto .imagen{
		display: flex;
		align-items: start;
		justify-content: start;
		min-height: 100px;
		width: 100%;
		border-radius: 8px;
		background-color: #409c94;
	}

	.proyecto h1{
		font-size: 1.5rem;
		margin: 0 0 0.5rem 0;
		font-family: "Arial", sans-serif;
	}
		.proyecto p{
		font-size: 1.5rem;
		margin: 0 0 0.5rem 0;
		font-family: "Arial", sans-serif;
		}

	.proyecto .descripcion{
		display: flex;
		flex-direction: column;
		align-items: start;
		justify-content: start;
		min-height: 5vh;
	}

	.proyecto .boton{
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 40px;
		width: 100px;
		border-radius: 8px;
		background-color: #409c94;
		color: #fffffc;
		font-family: "Arial", sans-serif;
		font-size: 1rem;
		text-align: center;
		cursor: pointer;
	}




</style>


